# ==============================================================================
# TAROTCUAHALLE - CẤU HÌNH BIẾN MÔI TRƯỜNG & AI API
# ==============================================================================
# Tạo một file tên là ".env" ở cùng thư mục với file này (hoặc thư mục gốc dự án)
# và dán API Key của bạn vào bên dưới:

# 1. CỔNG SERVER (Mặc định: 3456)
PORT=3456

# 2. CHỌN NHÀ CUNG CẤP AI (gemini HOẶC openai)
# - "gemini": Sử dụng Google Gemini (Khuyên dùng - tốc độ nhanh, phân tích sâu, miễn phí tier cao)
# - "openai": Sử dụng OpenAI (GPT-4o, GPT-4o-mini, v.v.)
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# CẤU HÌNH GOOGLE GEMINI AI
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Mô hình Gemini khuyên dùng:
# - gemini-3.8-flash (Mới nhất, siêu nhanh & thông minh)
# - gemini-3.5-flash (Cân bằng & ổn định)
# - gemini-2.5-flash (Hybrid reasoning model)
# - gemini-3.8-pro   (Lý luận sâu sắc, chi tiết toàn diện)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# CẤU HÌNH OPENAI (Tùy chọn nếu dùng OpenAI)
# Lấy API Key tại: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-...your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Có thể trỏ sang Base URL tương thích (DeepSeek, Groq, OpenRouter, v.v.)
# OPENAI_BASE_URL=https://api.openai.com/v1
